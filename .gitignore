# Python packaging dirs only (root-level); do NOT ignore frontend source.
# `lib/` used to match frontend/src/lib/, which silently excluded the whole
# frontend API layer (@/lib/api, @/lib/store, @/lib/utils) from the repo.
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

